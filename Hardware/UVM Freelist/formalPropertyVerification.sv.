module freelist_fv #(
  parameter int PHYS_REGS    = 51,
  parameter int RENAME_START = 32,
  parameter int ALLOC_PORTS  = 2,
  parameter int FREE_PORTS   = 2
)(
  input logic clk,
  input logic reset,
  input logic [ALLOC_PORTS-1:0]      alloc_en,
  input logic [ALLOC_PORTS-1:0][5:0] alloc_phys,
  input logic [ALLOC_PORTS-1:0]      alloc_valid,
  input logic [FREE_PORTS-1:0]       free_en,
  input logic [FREE_PORTS-1:0][5:0]  free_phys
);

  // ============================================================
  // ASSUMPTIONS — constrain inputs to legal values only
  // ============================================================

  // free_phys must always be in the rename register range
  // (architectural regs 0-31 are never in the free list)
  always_comb begin
    for (int i = 0; i < FREE_PORTS; i++) begin
      if (free_en[i])
        assume (free_phys[i] >= RENAME_START && free_phys[i] < PHYS_REGS);
    end
  end

  // can't free a register that's currently allocated to the same port
  // (would require knowing internal state — covered by the assertion side instead)

  // the two free ports can't free the same register simultaneously
  assume property (@(posedge clk)
    (free_en[0] && free_en[1]) |-> (free_phys[0] != free_phys[1]));

  // ============================================================
  // HELPER LOGIC — track internal state for assertion use
  // the formal tool can see the DUT's internals directly,
  // but sometimes it's cleaner to derive a helper signal
  // ============================================================

  // count how many registers are currently free
  // this is derived purely from the DUT's own free_mask
  logic [$clog2(PHYS_REGS+1)-1:0] free_count;
  always_comb begin
    free_count = '0;
    for (int i = RENAME_START; i < PHYS_REGS; i++)
      free_count += dut.free_mask[i];  // bind lets you reach inside the DUT
  end

  // ============================================================
  // ASSERTIONS — the actual properties being proven
  // ============================================================

  // PROPERTY 1: after reset, all rename registers are free
  // this proves your reset initialization logic is correct
  ap_reset_frees_all: assert property (
    @(posedge clk)
    $fell(reset) |->
      ##1 (free_count == (PHYS_REGS - RENAME_START))
  );

  // PROPERTY 2: alloc_valid can only be high if the list isn't empty
  // proves the DUT never "invents" a register
  ap_no_valid_when_empty: assert property (
    @(posedge clk) disable iff (reset)
    (free_count == 0) |-> ##1 (alloc_valid == 2'b00)
  );

  // PROPERTY 3: if alloc_en is low, alloc_valid must be low
  // proves outputs are quiet when not requested
  ap_no_alloc_without_request: assert property (
    @(posedge clk) disable iff (reset)
    !alloc_en[0] |-> ##1 !alloc_valid[0]
  );

  ap_no_alloc_without_request_p1: assert property (
    @(posedge clk) disable iff (reset)
    !alloc_en[1] |-> ##1 !alloc_valid[1]
  );

  // PROPERTY 4: two simultaneous allocations must return DIFFERENT registers
  // this is the critical correctness property for a superscalar rename unit
  // UVM can hit this case but can never PROVE it holds for all inputs
  ap_no_duplicate_alloc: assert property (
    @(posedge clk) disable iff (reset)
    (alloc_valid == 2'b11) |->
      (alloc_phys[0] != alloc_phys[1])
  );

  // PROPERTY 5: allocated registers are always in the valid rename range
  ap_alloc_in_range_p0: assert property (
    @(posedge clk) disable iff (reset)
    alloc_valid[0] |->
      (alloc_phys[0] >= RENAME_START && alloc_phys[0] < PHYS_REGS)
  );

  ap_alloc_in_range_p1: assert property (
    @(posedge clk) disable iff (reset)
    alloc_valid[1] |->
      (alloc_phys[1] >= RENAME_START && alloc_phys[1] < PHYS_REGS)
  );

  // PROPERTY 6: port 0 always gets the LOWEST free register
  // this proves the priority encoder is correct, not just that it allocates something
  ap_port0_lowest: assert property (
    @(posedge clk) disable iff (reset)
    alloc_valid[0] |->
      // no free register exists below what port 0 returned
      // (checked against DUT's own free_mask one cycle ago — pre-allocation)
      !$past(dut.free_mask[alloc_phys[0] - 1], 1)  // simplified; full version iterates
  );

  // PROPERTY 7: a freed register eventually becomes allocatable
  // this is a LIVENESS property — harder for formal, but critical for your use case
  // ("eventually" needs a bound in bounded model checking)
  ap_freed_becomes_available: assert property (
    @(posedge clk) disable iff (reset)
    (free_en[0] && free_phys[0] == 6'd32) |->
      ##2 dut.free_mask[32]  // freed reg should be back in mask within 2 cycles
  );

  // ============================================================
  // COVERS — prove these scenarios are actually reachable
  // if a cover fails, your assumptions are too tight
  // ============================================================

  // prove the list can actually be fully exhausted
  cp_list_exhausted: cover property (
    @(posedge clk) disable iff (reset)
    free_count == 0
  );

  // prove both ports can simultaneously return valid
  cp_dual_alloc: cover property (
    @(posedge clk) disable iff (reset)
    alloc_valid == 2'b11
  );

  // prove a freed register can be immediately re-allocated
  cp_free_then_realloc: cover property (
    @(posedge clk) disable iff (reset)
    (free_en[0] ##2 alloc_valid[0])
  );

endmodule
